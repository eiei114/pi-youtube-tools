{
  "name": "pi-youtube-tools",
  "version": "0.1.1",
  "description": "Native Pi extension for YouTube Data API search, video details, and transcripts without an MCP daemon.",
  "type": "module",
  "license": "MIT",
  "author": "eiei114",
  "keywords": [
    "pi-package",
    "pi",
    "youtube",
    "agent-skill",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-youtube-tools.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-youtube-tools/issues"
  },
  "homepage": "https://github.com/eiei114/pi-youtube-tools#readme",
  "files": [
    "extensions/",
    "lib/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "ci": "npm run typecheck && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run",
    "version:check": "node scripts/check-version-bump.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "youtube-transcript-plus": "^1.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "typebox": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
